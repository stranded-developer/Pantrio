# Copy to .env (laptop) or /etc/pantrio-bridge.env (STB).
# The first three lines come from Pantrio → Settings → Printers → Add printer.
PANTRIO_SUPABASE_URL=
PANTRIO_PUBLISHABLE_KEY=
PRINT_DEVICE_TOKEN=

# STB (Linux):         usb:/dev/usb/lp0
# Mac laptop:          cups:<printer name from `lpstat -p`>
# Windows laptop:      windows:<share name>
# No printer, testing: dry-run
PRINTER=dry-run
RECEIPT_WIDTH=32
