# Supabase → Project Settings → API Keys (new key format only).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key — safe in the browser, RLS enforces access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — bypasses RLS. Server-only. Needed for: backoffice, creating
# staff logins, resetting passwords. The POS itself never uses it.
SUPABASE_SECRET_KEY=

# Optional. Comma-separated hostnames that serve the platform itself (login,
# backoffice, /o/<slug>). *.vercel.app and localhost are always platform hosts.
# Any other hostname is looked up as a restaurant's custom domain.
PLATFORM_HOSTS=

# Optional: lets the backoffice add/remove custom domains on Vercel itself.
# Token: Vercel → Account Settings → Tokens. Project ID: Project → Settings.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional, for `pnpm --filter @pantrio/web types:db` (Supabase → Connect → Session pooler).
SUPABASE_DB_URL=
